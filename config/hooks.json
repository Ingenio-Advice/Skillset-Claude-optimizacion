{
 "SessionStart": [
  {
   "matcher": "startup",
   "hooks": [
    {
     "type": "command",
     "command": "__KIT__/hooks/session-start.sh"
    }
   ]
  }
 ],
 "Stop": [
  {
   "hooks": [
    {
     "type": "command",
     "command": "__KIT__/hooks/stop-cerrar.sh"
    }
   ]
  }
 ],
 "PreToolUse": [
  {
   "matcher": "Bash",
   "hooks": [
    {
     "type": "command",
     "command": "__KIT__/hooks/trabajo-afuera.sh"
    }
   ]
  }
 ]
}